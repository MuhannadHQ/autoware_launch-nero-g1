<launch>
  <arg name="launch_driver" default="true"/>

  <!-- Top-level GNSS source selector.
         xsens      : Xsens MTi provides BOTH GNSS and IMU (current default behavior).
         septentrio : Septentrio mosaic-G5 provides GNSS; Xsens MTi provides IMU only. -->
  <arg name="gnss_module" default="xsens" description="xsens or septentrio"/>

  <!-- gnss_poser inputs. Both sources publish the same topic names in this
       namespace, so the poser wiring below is identical for either module. -->
  <let name="navsatfix_topic_name" value="nav_sat_fix"/>
  <let name="orientation_topic_name" value="autoware_orientation"/>

  <!-- =========================== GNSS + IMU source =========================== -->

  <!-- Xsens: GNSS + IMU -->
  <group if="$(eval &quot;'$(var gnss_module)'=='xsens'&quot;)">
    <push-ros-namespace namespace="gnss"/>
    <include file="$(find-pkg-share xsens_gnss_bridge)/launch/xsens_gnss_bridge.launch.py">
      <arg name="launch_driver" value="$(var launch_driver)"/>
      <arg name="mode" value="gnss_imu"/>
    </include>
  </group>

  <!-- Septentrio: GNSS ; Xsens: IMU only -->
  <group if="$(eval &quot;'$(var gnss_module)'=='septentrio'&quot;)">
    <!-- Septentrio GNSS: publishes gnss/nav_sat_fix + gnss/autoware_orientation,
         runs its own host NTRIP bridge and base_link->gnss_link TF. -->
    <include file="$(find-pkg-share septentrio_gnss_bridge)/launch/septentrio_gnss.launch.xml">
      <arg name="namespace" value="gnss"/>
      <arg name="launch_driver" value="$(var launch_driver)"/>
    </include>

    <!-- Xsens IMU only: driver + IMU bridge, no GNSS/NTRIP publishers (no clash). -->
    <group>
      <push-ros-namespace namespace="gnss"/>
      <include file="$(find-pkg-share xsens_gnss_bridge)/launch/xsens_gnss_bridge.launch.py">
        <arg name="launch_driver" value="$(var launch_driver)"/>
        <arg name="mode" value="imu_only"/>
      </include>
    </group>
  </group>

  <!-- ===================== Common: NavSatFix -> MGRS Pose ===================== -->
  <group>
    <push-ros-namespace namespace="gnss"/>
    <include file="$(find-pkg-share autoware_gnss_poser)/launch/gnss_poser.launch.xml">
      <arg name="input_topic_fix" value="$(var navsatfix_topic_name)"/>
      <arg name="input_topic_orientation" value="$(var orientation_topic_name)"/>

      <arg name="output_topic_gnss_pose" value="pose"/>
      <arg name="output_topic_gnss_pose_cov" value="pose_with_covariance"/>
      <arg name="output_topic_gnss_fixed" value="fixed"/>

      <arg name="use_gnss_ins_orientation" value="true"/>
    </include>
  </group>

  <!-- ========================= Common: IMU corrector ========================= -->
  <group>
    <push-ros-namespace namespace="imu"/>
    <arg name="imu_raw_name" default="/sensing/gnss/imu/data"/>
    <arg name="imu_corrector_param_file" default="$(find-pkg-share fairy_e1r_airy_left_right_sensor_kit_description)/config/imu_corrector.param.yaml"/>
    <include file="$(find-pkg-share autoware_imu_corrector)/launch/imu_corrector.launch.xml">
      <arg name="input_topic" value="$(var imu_raw_name)"/>
      <arg name="output_topic" value="imu_data"/>
      <arg name="param_file" value="$(var imu_corrector_param_file)"/>
    </include>
  </group>

</launch>

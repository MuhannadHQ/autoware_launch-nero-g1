<launch>
  <arg name="launch_driver" default="true"/>
  <arg name="host_ip" default="192.168.1.102"/>
  <arg name="use_concat_filter" default="true"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="vehicle_mirror_param_file"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>

  <group>
    <push-ros-namespace namespace="lidar"/>

    <group if="$(var launch_driver)">
      <!-- Fairy Driver -->
      <group>
        <push-ros-namespace namespace="top"/>
        <include file="$(find-pkg-share fairy_common_sensor_launch)/launch/fairy_node_container.launch.py">
        </include>
      </group>    
    </group>

    <node pkg="topic_tools" exec="relay" name="pose_estimator_relay" output="log">
      <param name="input_topic" value="top/pointcloud_before_sync"/>
      <param name="output_topic" value="concatenated/pointcloud"/>
      <param name="type" value="sensor_msgs/msg/PointCloud2"/>
      <!-- <param name="reliability" value="reliable"/> -->
    </node>
    
  </group>
</launch>

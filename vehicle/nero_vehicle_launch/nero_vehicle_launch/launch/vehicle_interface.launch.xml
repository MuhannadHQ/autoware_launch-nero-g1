<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <!-- yhs_autoware_bridge braking: legacy = brake -acc*10 on every negative acc;
       plan = brake only to stop/hold or for acc < hard_brake_acc (RC2 collapse fix, 2026-10-06).
       Set from the launcher GUI (Brake mode) or brake_mode:=plan on the command line. -->
  <arg name="brake_mode" default="legacy"/>
  
  <!-- Bridge node -->
  <node
    pkg="yhs_autoware_bridge"
    exec="bridge_node"
    name="bridge_node"
    output="screen">
    <param name="brake_mode" value="$(var brake_mode)"/>
  </node>

  <!-- YHS Can Control -->
  <include file="$(find-pkg-share yhs_can_control)/launch/yhs_can_control.launch.py">
  </include> 

</launch>
